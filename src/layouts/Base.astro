---
import '../styles/global.css';
import { site, type Lang } from '../data/profile';
import { useT, href, altPath } from '../data/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
}

const { lang, title, description, image = '/og.png' } = Astro.props;
const t = useT(lang);
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline[lang]}`;
const desc = description ?? site.description[lang];
const canonical = new URL(Astro.url.pathname, site.url).href;
const enUrl = new URL(altPath(Astro.url.pathname, 'en'), site.url).href;
const viUrl = new URL(altPath(Astro.url.pathname, 'vi'), site.url).href;
const otherLang: Lang = lang === 'en' ? 'vi' : 'en';
const path = Astro.url.pathname;
const nav = [
  { label: t('nav.work'), path: '/work' },
  { label: t('nav.talks'), path: '/talks' },
  { label: t('nav.about'), path: '/about' },
];
const isActive = (p: string) => path.replace(/^\/vi/, '').replace(/\/$/, '').startsWith(p);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.fullName,
  url: site.url,
  image: `${site.url}/avatar.png`,
  email: `mailto:${site.email}`,
  jobTitle: 'Senior Application Engineer',
  worksFor: { '@type': 'Organization', name: 'Akselos' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Ho Chi Minh City University of Technology' },
  address: { '@type': 'PostalAddress', addressLocality: 'Ho Chi Minh City', addressCountry: 'VN' },
  knowsAbout: ['Computational Fluid Dynamics', 'CAE', 'Digital Twins', 'OpenFOAM', 'Product Management', 'AI Agents'],
  sameAs: [site.linkedin],
};
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="vi" href={viUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#070c16" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'vi_VN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap&subset=vietnamese"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const s = localStorage.getItem('theme');
        const t = s || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
    <header id="site-header" class="fixed inset-x-0 top-0 z-40 transition-colors duration-300" data-solid="false">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href={href(lang, '/')} class="group flex items-center gap-2.5 font-display text-[15px] font-semibold tracking-tight">
          <svg viewBox="0 0 64 64" class="h-7 w-7" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#0b1220" /><path d="M10 40c10-14 18-14 26-6s14 8 18-4" fill="none" stroke="#38bdf8" stroke-width="5" stroke-linecap="round" /><path d="M10 26c8-8 14-8 20-3" fill="none" stroke="#fbbf24" stroke-width="5" stroke-linecap="round" /></svg>
          <span class="header-ink">Nghiep Nguyen</span>
        </a>
        <nav class="flex items-center gap-1 text-sm" aria-label="Main">
          {nav.map((n) => (
            <a
              href={href(lang, n.path)}
              class:list={['header-ink hidden rounded-full px-3 py-1.5 transition-colors hover:bg-white/10 sm:inline-block', isActive(n.path) && 'font-semibold']}
              aria-current={isActive(n.path) ? 'page' : undefined}
            >{n.label}</a>
          ))}
          <a href={altPath(path, otherLang)} hreflang={otherLang} class="header-ink rounded-full px-2.5 py-1.5 font-mono text-xs uppercase tracking-wider hover:bg-white/10" title={t('lang.switch')}>
            {otherLang}
          </a>
          <button id="theme-toggle" type="button" class="header-ink grid h-9 w-9 place-items-center rounded-full hover:bg-white/10" aria-label={t('theme.toggle')}>
            <svg class="h-[18px] w-[18px] dark-only" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="h-[18px] w-[18px] light-only" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          </button>
          <a href={`mailto:${site.email}`} class="ml-1 hidden rounded-full bg-accent text-on-accent px-4 py-1.5 font-medium transition hover:brightness-110 md:inline-block">
            {t('nav.contact')}
          </a>
        </nav>
      </div>
      <nav class="flex justify-center gap-1 pb-2 text-sm sm:hidden" aria-label="Mobile">
        {nav.map((n) => (
          <a href={href(lang, n.path)} class:list={['header-ink rounded-full px-3 py-1', isActive(n.path) && 'font-semibold']}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div>
          <div class="font-display font-semibold text-ink">{site.name}</div>
          <div>{site.role[lang]} · {site.location[lang]}</div>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <a class="hover:text-ink" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="hover:text-ink" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <span>© {new Date().getFullYear()}</span>
        </div>
      </div>
      <div class="colormap-bar h-1 w-full opacity-80"></div>
    </footer>

    <style is:global>
      #site-header .header-ink { color: #e6edf7; }
      #site-header[data-solid='true'] {
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }
      #site-header[data-solid='true'] .header-ink { color: var(--ink); }
      :root[data-theme='light'] #site-header[data-solid='true'] .hover\:bg-white\/10:hover { background: rgba(11, 18, 32, 0.06); }
      :root[data-theme='dark'] .light-only, :root[data-theme='light'] .dark-only { display: none; }
    </style>
    <script>
      const header = document.getElementById('site-header')!;
      const hero = document.querySelector('[data-hero]');
      const update = () => {
        const limit = hero ? hero.getBoundingClientRect().bottom - 64 : -1;
        header.dataset.solid = String(!hero || limit <= 0);
      };
      update();
      addEventListener('scroll', update, { passive: true });

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -10% 0px' },
      );
      const pending = new Set(document.querySelectorAll('.reveal'));
      pending.forEach((el) => io.observe(el));
      // Safety net: anything already scrolled past is revealed even if IO missed it.
      const sweep = () => pending.forEach((el) => {
        if (el.getBoundingClientRect().top < innerHeight) { el.classList.add('is-visible'); pending.delete(el); io.unobserve(el); }
      });
      addEventListener('scroll', sweep, { passive: true });
      sweep();
    </script>
  </body>
</html>
