---
import Base from '../layouts/Base.astro';
import { type Lang } from '../data/profile';
import { useT, href } from '../data/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<Base lang={lang} title="404">
  <section class="mesh-bg grid min-h-[80vh] place-items-center px-4 pt-24 text-center">
    <div>
      <div class="colormap-text font-display text-8xl font-bold">404</div>
      <h1 class="mt-4 font-display text-3xl font-semibold">{t('notfound.title')}</h1>
      <p class="mt-3 text-muted">{t('notfound.body')}</p>
      <a href={href(lang, '/')} class="mt-8 inline-block rounded-full bg-accent text-on-accent px-6 py-3 font-medium">{t('notfound.home')}</a>
    </div>
  </section>
</Base>
