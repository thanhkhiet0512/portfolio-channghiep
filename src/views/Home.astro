---
import Base from '../layouts/Base.astro';
import FluidHero from '../components/FluidHero.astro';
import WorkCard from '../components/WorkCard.astro';
import SectionHead from '../components/SectionHead.astro';
import Contact from '../components/Contact.astro';
import CaseArt from '../components/CaseArt.astro';
import { stats, pillars, projects, journey, talks, type Lang } from '../data/profile';
import { useT, href } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const featured = projects.filter((p) => p.featured);
const talk = talks[0];
const icons: Record<string, string> = {
  sim: 'M3 12c3-6 6-6 9 0s6 6 9 0M3 17c3-4 6-4 9 0s6 4 9 0M3 7c3-4 6-4 9 0s6 4 9 0',
  product: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  ai: 'M12 2v3M12 19v3M2 12h3M19 12h3M7 7h10v10H7zM10 10h4v4h-4z',
};
---
<Base lang={lang}>
  <FluidHero lang={lang} />

  <!-- Trust strip -->
  <section class="border-b border-line bg-surface">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-3 px-4 py-5 text-sm text-muted sm:justify-between sm:px-6">
      <a href={href(lang, '/talks')} class="flex items-center gap-2 font-medium text-ink hover:text-accent">
        <span class="text-warm">★</span>{t('trust.speaker')}
      </a>
      <span class="font-display font-semibold tracking-wide">AKSELOS</span>
      <span class="font-display font-semibold tracking-wide">TECHNOSTAR</span>
      <span class="font-display font-semibold tracking-wide">HCMUT · BÁCH KHOA</span>
    </div>
  </section>

  <!-- Stats -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <h2 class="sr-only">{t('stats.title')}</h2>
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3">
      {stats.map((s) => (
        <div class="reveal bg-surface p-6 sm:p-8">
          <div class="font-display text-3xl font-bold tracking-tight text-ink sm:text-5xl" data-count={s.value}>{s.value}</div>
          <div class="mt-2 text-sm text-muted">{s.label[lang]}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Pillars -->
  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    <SectionHead eyebrow={t('pillars.eyebrow')} title={t('pillars.title')} />
    <div class="grid gap-5 md:grid-cols-3">
      {pillars.map((p, i) => (
        <div class="reveal relative rounded-2xl border border-line bg-surface p-6" style={`transition-delay:${i * 80}ms`}>
          <div class="mb-5 grid h-11 w-11 place-items-center rounded-xl bg-accent/10 text-accent ring-1 ring-accent/30">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons[p.key]} /></svg>
          </div>
          <h3 class="font-display text-xl font-semibold">{p.title[lang]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{p.body[lang]}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {p.tags.map((tag) => <span class="rounded-md bg-surface-2 px-2 py-1 font-mono text-[11px] text-muted">{tag}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured work -->
  <section class="border-t border-line bg-surface-2/40">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHead eyebrow={t('work.eyebrow')} title={t('work.title')} />
        <a href={href(lang, '/work')} class="reveal mb-10 text-sm font-medium text-accent hover:underline">{t('work.all')} →</a>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {featured.map((p, i) => <WorkCard p={p} lang={lang} large={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- Talk highlight -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="reveal grid items-center gap-8 overflow-hidden rounded-3xl border border-line bg-surface md:grid-cols-[1.1fr_1fr]">
      <div class="p-8 sm:p-10">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-warm">{t('talk.eyebrow')} · {talk.event} · {talk.place[lang]}</p>
        <h2 class="font-display text-2xl font-semibold leading-snug tracking-tight sm:text-3xl">“{talk.title}”</h2>
        <p class="mt-4 text-muted">{talk.type[lang]} — {talk.event}, {talk.place[lang]}, {talk.year}.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={href(lang, `/work/${talk.project}`)} class="rounded-full bg-accent text-on-accent px-5 py-2.5 text-sm font-medium hover:brightness-110">{t('talk.read')} →</a>
          <a href={talk.url} target="_blank" rel="noopener" class="rounded-full border border-line px-5 py-2.5 text-sm font-medium hover:border-accent/60">{t('talk.event')} ↗</a>
        </div>
      </div>
      <div class="h-full min-h-56 border-t border-line bg-surface-2 text-ink md:border-l md:border-t-0">
        <CaseArt art="tank" />
      </div>
    </div>
  </section>

  <!-- Journey -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <SectionHead eyebrow={t('journey.eyebrow')} title={t('journey.title')} />
      <ol class="relative ml-2 border-l border-line">
        <span class="absolute -left-px top-0 w-px bg-gradient-to-b from-sky-500 via-cyan-300 to-amber-400" id="journey-progress" style="height:0%"></span>
        {journey.map((s) => (
          <li class="reveal relative pb-12 pl-8 last:pb-0">
            <span class:list={['absolute -left-[7px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-bg', s.kind === 'edu' ? 'bg-warm' : 'bg-accent']}></span>
            <div class="font-mono text-xs text-accent">{s.year} · {s.org}</div>
            <h3 class="mt-1 font-display text-xl font-semibold">{s.role[lang]}</h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{s.body[lang]}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Contact lang={lang} />
</Base>

<script>
  const bar = document.getElementById('journey-progress');
  const list = bar?.parentElement;
  if (bar && list) {
    const upd = () => {
      const r = list.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.7 - r.top) / r.height));
      bar.style.height = `${p * 100}%`;
    };
    upd();
    addEventListener('scroll', upd, { passive: true });
  }
</script>
