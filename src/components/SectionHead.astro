---
interface Props { eyebrow: string; title: string; id?: string }
const { eyebrow, title, id } = Astro.props;
---
<div class="reveal mb-10 max-w-2xl" id={id}>
  <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">{eyebrow}</p>
  <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  <slot />
</div>
